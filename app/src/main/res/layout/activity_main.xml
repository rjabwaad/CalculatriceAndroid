<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#FFF5FA"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- Écran de résultat -->
    <TextView
        android:id="@+id/tvResult"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="#F8E6FF"
        android:text="0"
        android:textSize="40sp"
        android:gravity="end|center_vertical"
        android:padding="20dp"
        android:textColor="#8B2BBF" />

    <!-- Ligne Clear -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btnClear"
            android:text="C"
            style="@style/OpButton" />
    </LinearLayout>
    <!-- Ligne fonctions spéciales: ( ) ^ % -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnOpen"
            android:text="("
            style="@style/OpButton"/>
        <Button
            android:id="@+id/btnClose"
            android:text=")"
            style="@style/OpButton"/>
        <Button
            android:id="@+id/btnPower"
            android:text="^"
            style="@style/OpButton"/>
        <Button
            android:id="@+id/btnPercent"
            android:text="%"
            style="@style/OpButton"/>
    </LinearLayout>

    <!-- Ligne 7 8 9 / -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button android:id="@+id/btn7" android:text="7" style="@style/NumberButton"/>
        <Button android:id="@+id/btn8" android:text="8" style="@style/NumberButton"/>
        <Button android:id="@+id/btn9" android:text="9" style="@style/NumberButton"/>
        <Button android:id="@+id/btnDivide" android:text="/" style="@style/OpButton"/>
    </LinearLayout>

    <!-- Ligne 4 5 6 * -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button android:id="@+id/btn4" android:text="4" style="@style/NumberButton"/>
        <Button android:id="@+id/btn5" android:text="5" style="@style/NumberButton"/>
        <Button android:id="@+id/btn6" android:text="6" style="@style/NumberButton"/>
        <Button android:id="@+id/btnMultiply" android:text="*" style="@style/OpButton"/>
    </LinearLayout>

    <!-- Ligne 1 2 3 - -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button android:id="@+id/btn1" android:text="1" style="@style/NumberButton"/>
        <Button android:id="@+id/btn2" android:text="2" style="@style/NumberButton"/>
        <Button android:id="@+id/btn3" android:text="3" style="@style/NumberButton"/>
        <Button android:id="@+id/btnMinus" android:text="-" style="@style/OpButton"/>
    </LinearLayout>

    <!-- Ligne 0 . = + -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button android:id="@+id/btn0" android:text="0" style="@style/NumberButton"/>
        <Button android:id="@+id/btnDot" android:text="." style="@style/NumberButton"/>
        <Button android:id="@+id/btnEquals" android:text="=" style="@style/OpButton"/>
        <Button android:id="@+id/btnPlus" android:text="+" style="@style/OpButton"/>
    </LinearLayout>

</LinearLayout>
